{
  "name": "step-beni-mellal-3d",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "STEP Béni Mellal 3D : maquette 3D interactive de la station d'épuration des eaux usées de Béni Mellal (FR/EN)",
  "author": "Ilyass Zerqtouni",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "geometry": "python tools/build_geometry.py ..",
    "build:pages": "tsc --noEmit && vite build --base=./ --outDir docs --emptyOutDir"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18"
  }
}
